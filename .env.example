# Copy this file to .env, then replace every CHANGE_ME_* value before starting.
# Do not commit .env or any file under secrets/.

# MySQL (Docker Compose service name: mysql)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=news_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch
ES_HOST=http://elasticsearch:9200
ES_URL=http://elasticsearch:9200

# RabbitMQ (Docker Compose service name: rabbitmq)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=fengtong
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_INVITE_CODE=CHANGE_ME_ADMIN_INVITE_CODE
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEBUG=false

# Dify AI (optional until the AI feature is used)
DIFY_CREATIVE_API_KEY=
DIFY_RISK_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1/workflows/run

# Alipay (optional until the payment feature is used)
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_REDIRECT_URI=http://localhost:3000/checkout/callback
ALIPAY_NOTIFY_URL=http://localhost:8000/api/alipay/notify
# Put PEM files in secrets/alipay_private_key.pem and secrets/alipay_public_key.pem.

# Alibaba Cloud SMS (optional until SMS login is used)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_TEMPLATE_LOGIN=
SMS_TEMPLATE_CHANGE=

# Baidu Map (optional until map geocoding is used)
BAIDU_MAP_AK=

# Payment timeout in minutes
PAYMENT_WINDOW_MINUTES=15
